{{define "flow_card"}}<label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 transition-colors hover:border-brand-700 has-checked:border-brand-700 has-checked:bg-brand-50 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-brand-700 dark:border-slate-700 dark:hover:border-brand-400 dark:has-checked:border-brand-400 dark:has-checked:bg-brand-950">
<input type="radio" name="flow" value="{{.ID}}" required{{if .Selected}} checked{{end}} class="mt-1 size-4 shrink-0 accent-brand-700">
{{if .IconURL}}<img src="{{.IconURL}}" alt="" class="size-8 shrink-0 object-contain">{{end}}
<span class="flex flex-col"><span class="font-medium">{{.Title}}</span>{{if .Description}}<span class="text-sm text-slate-600 dark:text-slate-400">{{.Description}}</span>{{end}}</span>
</label>
{{end}}
