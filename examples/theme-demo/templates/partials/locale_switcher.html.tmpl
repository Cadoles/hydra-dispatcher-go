{{define "locale_switcher"}}{{if gt (len .Locales) 1}}<form method="post" class="flex flex-wrap justify-center gap-2 text-sm" aria-label="{{.T "locale.label"}}">{{with .Return}}<input type="hidden" name="return" value="{{.}}">{{end}}{{range .Locales}}<button type="submit" formaction="{{.Action}}" lang="{{.Code}}"{{if .Current}} aria-current="true" disabled{{end}} class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-slate-700 hover:bg-white focus-visible:outline-2 focus-visible:outline-brand-700 disabled:bg-white disabled:font-semibold disabled:text-slate-900 disabled:shadow-sm dark:text-slate-300 dark:hover:bg-slate-900 dark:disabled:bg-slate-900 dark:disabled:text-white">{{with .Flag}}<img src="{{.}}" alt="" class="h-3 w-4.5 rounded-sm">{{end}}{{.Label}}</button>{{end}}</form>{{end}}{{end}}
