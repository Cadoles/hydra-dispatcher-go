{
  "request": {
    "method": "PUT",
    "uri": "/admin/oauth2/auth/requests/consent/accept?consent_challenge=\u003cchallenge\u003e",
    "body": {
      "grant_scope": [
        "openid",
        "profile",
        "email"
      ],
      "remember": true,
      "session": {
        "id_token": {
          "email": "alice@example.com"
        }
      }
    }
  },
  "response": {
    "status": 401,
    "content_type": "application/json",
    "body": {
      "error": "request_unauthorized",
      "error_description": "The request could not be authorized. The consent request has expired, please try again."
    }
  }
}
