{{define "content"}}
<hgroup>
<h1>API clients</h1>
<p>The clients of the admin API, /admin/v1: their scopes. Their secrets are never shown again.</p>
</hgroup>
{{template "notice" .}}
{{- if .CanWrite}}
<p><a href="{{.Base}}/clients/_new" role="button">New API client</a></p>
{{- end}}
{{- with .Data}}
{{- if .Clients}}
<div class="overflow-auto">
<table>
<thead><tr><th scope="col">Id</th><th scope="col">Scopes</th></tr></thead>
<tbody>
{{- range .Clients}}
<tr><td><a href="{{$.Base}}/clients/{{path .ID}}">{{.ID}}</a></td><td>{{range $i, $s := .Scopes}}{{if $i}}, {{end}}{{$s}}{{else}}none{{end}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- else}}
<p>No API client yet.</p>
{{- end}}
{{- end}}
{{end}}
