{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="referrer" content="same-origin">
<title>{{.Title}} · Hydra dispatcher</title>
<link rel="stylesheet" href="{{.Asset}}">
<link rel="stylesheet" href="{{.Styles}}">
<link rel="icon" href="data:,">
</head>
<body>
<header>
<nav>
<ul><li><strong>Hydra dispatcher</strong></li></ul>
{{- if .Account}}
<ul>
<li><a href="{{.Base}}"{{if eq .Nav "dashboard"}} aria-current="page"{{end}}>Dashboard</a></li>
<li><a href="{{.Base}}/flows"{{if eq .Nav "flows"}} aria-current="page"{{end}}>Flows</a></li>
<li><a href="{{.Base}}/apps"{{if eq .Nav "apps"}} aria-current="page"{{end}}>Apps</a></li>
<li><a href="{{.Base}}/settings"{{if eq .Nav "settings"}} aria-current="page"{{end}}>Settings</a></li>
<li>{{.Account.Username}} <small>({{.Account.Role}})</small></li>
<li><form method="post" action="{{.Base}}/logout"><input type="hidden" name="csrf" value="{{.CSRF}}"><button type="submit">Log out</button></form></li>
</ul>
{{- end}}
</nav>
</header>
<main>
{{template "content" .}}
</main>
<footer><small>{{.Version}}</small></footer>
</body>
</html>
{{end}}
