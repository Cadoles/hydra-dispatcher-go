{{define "content"}}
{{- with .Data}}
<article>
{{- if .Key}}
<h1>The key of {{.ID}}</h1>
<p>{{if .Created}}The app is created.{{else}}The key is made again: the former one no longer signs.{{end}} Copy its key into the app's configuration now: it is shown this once, and kept encrypted.</p>
<label for="secret">Key</label>
{{- else}}
<h1>The secret of {{.ID}}</h1>
<p>{{if .Created}}The {{.What}} is created.{{else}}The secret is turned: the former one no longer gives a token.{{end}} Copy its secret now: it is shown this once, and kept only as a hash.</p>
<label for="secret">Secret</label>
{{- end}}
<input id="secret" readonly value="{{.Secret}}" autocomplete="off" spellcheck="false">
<p><a href="{{.Back}}">Go on to the {{.What}}</a></p>
</article>
{{- end}}
{{end}}
