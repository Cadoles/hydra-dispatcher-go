{{define "content"}}
{{- with .Data}}
<article>
<h1>The secret of {{.ID}}</h1>
<p>{{if .Created}}The client is created.{{else}}The secret is turned: the former one no longer gives a token.{{end}} Copy its secret now: it is shown this once, and kept only as a hash.</p>
<label for="secret">Secret</label>
<input id="secret" readonly value="{{.Secret}}" autocomplete="off" spellcheck="false">
<p><a href="{{$.Base}}/clients/{{path .ID}}">Go on to the client</a></p>
</article>
{{- end}}
{{end}}
