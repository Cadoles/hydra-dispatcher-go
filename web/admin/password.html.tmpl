{{define "content"}}
{{- with .Data}}
<h1>Your password</h1>
<p>Your other sessions, in other browsers, end with the change; this one goes on.</p>
{{template "general" .Errors}}
<form method="post" action="{{$.Base}}/account/password">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="username" value="{{.Account.Username}}" autocomplete="username">
<label>New password
<input type="password" name="password" minlength="12" required autocomplete="new-password"{{if .Errors.For "password"}} aria-invalid="true"{{end}}>
{{template "errors" .Errors.For "password"}}
<small>12 characters at least.</small>
</label>
<label>The new password again
<input type="password" name="password_again" required autocomplete="new-password">
</label>
<button type="submit">Change your password</button>
</form>
<p><a href="{{$.Base}}/account">Back to your account</a></p>
{{- end}}
{{end}}
