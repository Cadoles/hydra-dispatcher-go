{{define "content"}}
<hgroup>
<h1>Flows</h1>
<p>The ways of logging in a user may choose: their steps, in order.</p>
</hgroup>
{{template "notice" .}}
{{- if .CanWrite}}
<p><a href="{{.Base}}/flows/_new" role="button">New flow</a></p>
{{- end}}
{{- with .Data}}
{{- if .Flows}}
<table>
<thead><tr><th scope="col">Id</th><th scope="col">Title</th><th scope="col">State</th><th scope="col">Steps</th><th scope="col">ACR</th></tr></thead>
<tbody>
{{- range .Flows}}
<tr><td><a href="{{$.Base}}/flows/{{path .ID}}">{{.ID}}</a></td><td>{{.Title}}</td><td>{{if .Enabled}}enabled{{else}}<strong>disabled</strong>{{end}}</td><td>{{range $i, $s := .Steps}}{{if $i}} → {{end}}{{$s}}{{end}}</td><td>{{.ACR}}</td></tr>
{{- end}}
</tbody>
</table>
{{- else}}
<p>No flow yet.</p>
{{- end}}
{{- end}}
{{end}}
