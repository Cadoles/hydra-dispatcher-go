{{define "content"}}
{{- with .Data}}
<hgroup>
<h1>{{if .New}}New API client{{else}}API client {{.ID}}{{end}}</h1>
<p>{{if .New}}Its secret is generated, and shown once on the next page.{{else}}Its secret is never shown again: turn it to have a new one.{{end}}</p>
</hgroup>
{{template "notice" $}}
{{template "general" .Errors}}
<form method="post" action="{{if .New}}{{$.Base}}/clients{{else}}{{$.Base}}/clients/{{path .ID}}{{end}}">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="version" value="{{.Version}}">
<fieldset{{if not $.CanWrite}} disabled{{end}}>
{{- if .New}}
<label>Id
<input name="id" value="{{.ID}}" required maxlength="128"{{if .Errors.For "id"}} aria-invalid="true"{{end}}>
{{template "errors" .Errors.For "id"}}
<small>Up to 128 letters, digits, '.', '_' or '-', starting with a letter or a digit: its client_id. It never changes.</small>
</label>
{{- end}}
<fieldset>
<legend>Scopes</legend>
{{- range .Scopes}}
<label><input type="checkbox" name="scope" value="{{.Name}}"{{if .Checked}} checked{{end}}> {{.Name}}</label>
{{- end}}
{{template "errors" .Errors.For "scopes"}}
</fieldset>
</fieldset>
{{- if $.CanWrite}}
<button type="submit">{{if .New}}Create, and show its secret{{else}}Save the scopes{{end}}</button>
{{- end}}
</form>
{{- if and $.CanWrite (not .New)}}
<p><a href="{{$.Base}}/clients/{{path .ID}}/rotate">Turn its secret</a> · <a href="{{$.Base}}/clients/{{path .ID}}/delete">Delete this client</a></p>
{{- end}}
<p><a href="{{$.Base}}/clients">Back to the API clients</a></p>
{{- end}}
{{end}}
