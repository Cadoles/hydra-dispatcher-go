{{define "content"}}
{{- with .Data}}
<article>
<h1>Delete the app {{.Form.ID}}?</h1>
{{template "general" .Errors}}
{{- if .Flows}}
<p>It is a step of {{template "flows" .Flows}}: take it out of them first.</p>
{{- else}}
<p>It is a step of no flow. Its deletion cannot be undone.</p>
<form method="post" action="{{$.Base}}/apps/{{path .Form.ID}}/delete">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<button type="submit">Delete the app {{.Form.ID}}</button>
</form>
{{- end}}
<p><a href="{{$.Base}}/apps/{{path .Form.ID}}">Back to the app</a></p>
</article>
{{- end}}
{{end}}
