{{define "layout"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{block "title" .}}{{end}}</title>
<link rel="stylesheet" href="{{.Asset "base.css"}}">
<link rel="stylesheet" href="{{.Asset "theme.css"}}">
{{with .Asset "theme.js"}}<script src="{{.}}" defer></script>
{{end}}{{block "head" .}}{{end}}</head>
<body>
<header>{{block "header" .}}{{template "client_header" .}}{{end}}</header>
<main>
{{block "content" .}}{{end}}
</main>
<footer>{{block "footer" .}}{{template "locale_switcher" .}}{{end}}</footer>
</body>
</html>
{{end}}
