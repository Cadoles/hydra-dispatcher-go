{{define "locale_switcher"}}{{if gt (len .Locales) 1}}<form method="post" class="locales" aria-label="{{.T "locale.label"}}">{{with .Return}}<input type="hidden" name="return" value="{{.}}">{{end}}{{range .Locales}}<button type="submit" formaction="{{.Action}}" lang="{{.Code}}"{{if .Current}} aria-current="true" disabled{{end}}>{{with .Flag}}<img class="flag" src="{{.}}" alt="">{{end}}{{.Label}}</button>{{end}}</form>{{end}}{{end}}
