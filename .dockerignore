# Allowlist: only the Go sources this Dockerfile, tools/recorder/Dockerfile and
# examples/skipcheck-app/Dockerfile
# build from enter the context, never a local binary
# (cmd/hydra-dispatcher/hydra-dispatcher after a go build there), an .env or
# editor files. Files a package embeds will need a line of their own.
*
!go.mod
!go.sum
!cmd/**/*.go
!internal/**/*.go
!tools/**/*.go
!examples/skipcheck-app/**/*.go
# Embedded by internal/store, internal/i18n, web and api.
!internal/store/migrations/*.sql
!internal/i18n/*.json
!web/**/*.go
!web/templates/**
!web/static/**
!web/scalar/standalone.js
!web/scalar/init.js
!web/pico/pico.classless.min.css
!web/admin/**
!api/*.go
!api/openapi.yaml
**/*_test.go
**/testdata
